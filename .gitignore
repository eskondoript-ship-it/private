# Secrets. Never commit a real credential — the example file is the only one
# that belongs in the repo.
.env
.env.*
!.env.example

node_modules/
.DS_Store

# The local slur list. Shipping one in a repository creates a slur list in a
# repository; the filter loads this file when it is present and redacts
# anything it matches out of the audit trail. See database/safety/rules.json.
database/safety/slurs.local.txt

# The measurement cache. It is regenerable — at the cost of re-spending quota —
# and a run over ten thousand channels makes it tens of megabytes that churn on
# every commit. Keep it on disk, out of git. Deleting it is safe but not free.
database/data/measured.json

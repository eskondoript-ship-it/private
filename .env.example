# NovaClip — Creator Intelligence
# ============================================================================
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# WHERE THESE ACTUALLY LIVE IN PRODUCTION
# This project has no Node server — it is static pages plus Cloudflare Workers.
# At runtime the Workers read these from Cloudflare's own secret store, not
# from a file:
#
#   wrangler secret put YOUTUBE_API_KEY
#   ...or Dashboard -> your Worker -> Settings -> Variables and Secrets
#
# This file is for `wrangler dev`, which does read a .env, and to document the
# exact names. No value here is ever sent to a browser.
# ============================================================================

# --- YouTube -----------------------------------------------------------------
# Server API key. No OAuth, no approval. Enable "YouTube Data API v3" first.
# console.cloud.google.com -> APIs & Services -> Credentials -> API key
YOUTUBE_API_KEY=

# --- Twitch ------------------------------------------------------------------
# App access token via client credentials. No user consent needed.
# dev.twitch.tv/console/apps -> Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- TikTok ------------------------------------------------------------------
# User OAuth only. Login Kit + Display API must be added to the app and the
# redirect URI below registered exactly. Reading OTHER creators needs the
# Research API, which is a separate academic application.
# developers.tiktok.com -> Manage apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Instagram ---------------------------------------------------------------
# User OAuth, professional (Creator/Business) accounts linked to a Facebook
# Page. A personal account cannot return insights — that is Meta's rule.
# developers.facebook.com -> My Apps -> Instagram Graph API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- AI ----------------------------------------------------------------------
# These live on ai-worker.js. Listed here so the status page can report them.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Storage and crypto ------------------------------------------------------
# DATABASE_URL is unused by the Workers (storage is the KV binding named DB).
# It is here because external tooling may want it.
DATABASE_URL=

# Required before any OAuth connection is allowed. OAuth tokens are encrypted
# at rest with AES-GCM using a key derived from this. Generate one with:
#   openssl rand -base64 32
# Changing it invalidates every stored connection, which then reads as
# disconnected and can simply be reconnected.
TOKEN_ENCRYPTION_KEY=

# The public origin of the integrations Worker. Used to build the OAuth
# redirect URIs, which must match what you registered with TikTok and Meta:
#   <PUBLIC_URL>/auth/tiktok/callback
#   <PUBLIC_URL>/auth/instagram/callback
PUBLIC_URL=

# --- Channel database --------------------------------------------------------
# Publishing a built database, and reading the review and rejected lists.
# Those two lists say "this channel was removed, and here is the rule that
# removed it", so they are never served without this token. Generate one with:
#   openssl rand -base64 32
# Without it the public list still works and the two private lists answer 401.
ADMIN_TOKEN=
